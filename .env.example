# Configure a real local login pair, or configure the complete OIDC tuple below.
# The blank defaults intentionally make an unedited copy fail closed at startup.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required for Sonarr integration.
SONARR_API_KEY=replace_with_your_sonarr_api_key
SONARR_HOST=http://sonarr:8989
# Optional browser-facing Sonarr URL. Defaults to SONARR_HOST when empty.
SONARR_PUBLIC_URL=

# Optional TMDB integration.
TMDB_API_KEY=

# Docker Compose binds to loopback by default. Set to 0.0.0.0 only for deliberate LAN exposure.
# BIND_ADDRESS=0.0.0.0

# Optional settings for docker-compose.traefik.yml.
# MIKANARR_HOST=mikanarr.example.com
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure

# The application runs on HTTP behind the loopback binding and should normally sit behind a TLS proxy.
# Leave true in production. Set false only for local HTTP development/testing.
COOKIE_SECURE=true

# Trust exactly this many reverse-proxy hops when deriving the client IP for login throttling.
# Keep 0 unless every request follows a fixed, protected proxy path; an excessive value permits X-Forwarded-For spoofing.
TRUST_PROXY_HOPS=0

# Optional OIDC login. All four values form one required tuple. HTTPS is required in production.
# OIDC_ISSUER=https://auth.example.com/application/o/mikanarr/
# OIDC_CLIENT_ID=mikanarr
# OIDC_CLIENT_SECRET=replace_with_your_oidc_client_secret
# OIDC_REDIRECT_URI=https://mikanarr.example.com/auth/oidc/callback
# Authorize at least one subject or one group; both may be used.
# OIDC_ALLOWED_SUBJECTS=alice-subject,bob-subject
# OIDC_REQUIRED_GROUP=mikanarr-users
# OIDC_GROUPS_CLAIM=groups
# OIDC_AUTO_LOGIN=false
