# Sonarr 配置
SONARR_API_KEY=your_sonarr_api_key_here
# 内部访问地址 (Mikanarr -> Sonarr)
SONARR_HOST=http://sonarr:8989
# 外部访问地址 (浏览器 -> Sonarr)，可选，不填则使用 SONARR_HOST
SONARR_PUBLIC_URL=https://sonarr.yourdomain.com

# TMDB API Key（可选，用于显示中文剧集信息）
TMDB_API_KEY=your_tmdb_api_key_here

# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# OIDC / OAuth2 配置 (可选，用于 SSO 登录)
# OIDC_CLIENT_ID=your_client_id
# OIDC_CLIENT_SECRET=your_client_secret
# OIDC_AUTH_URL=https://authentik.yourdomain.com/application/o/authorize/
# OIDC_TOKEN_URL=https://authentik.yourdomain.com/application/o/token/
# OIDC_REDIRECT_URI=https://mikanarr.yourdomain.com/auth/oidc/callback
# OIDC_AUTO_LOGIN=true # 如果设置为 true，将隐藏登录表单并直接跳转到 SSO

# 服务器端口（可选，默认 12306）
PORT=12306
